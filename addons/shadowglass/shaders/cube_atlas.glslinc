#version 450
// =============================================================================
// Shadow Glass - cube atlas sampling convention (SOURCE OF TRUTH).
// -----------------------------------------------------------------------------
// This file documents the single face/direction convention shared by the
// capture cameras (see core/capture_bank.gd) and the atlas sampling code.
// reprojection.glsl contains an identical inline copy of these helpers
// (Godot's .glsl importer include support is not relied upon); keep the two in
// sync by editing this reference first.
//
// Face order / atlas layout (3x2 tiles, 3 columns x 2 rows):
//   face 0 = +X  face 1 = -X  face 2 = +Y
//   face 3 = -Y  face 4 = +Z  face 5 = -Z
//
//   atlas pixels: tile(face) origin = (col*res, row*res) where
//   col = face % 3, row = face / 3.  Row 0 is the TOP of the atlas.
//
// Per-face orientation (view = face normal the camera looks down,
// up = direction rendered to the TOP of the tile, right = view x up):
//   +X: view(+1,0,0)  up(0,-1,0)  right(0,0,-1)
//   -X: view(-1,0,0)  up(0,-1,0)  right(0,0,+1)
//   +Y: view(0,+1,0)  up(0,0,+1)  right(+1,0,0)
//   -Y: view(0,-1,0)  up(0,0,-1)  right(+1,0,0)
//   +Z: view(0,0,+1)  up(0,-1,0)  right(+1,0,0)
//   -Z: view(0,0,-1)  up(0,-1,0)  right(-1,0,0)
//
// Direction -> local UV (derived from the capture camera projection, aspect=1,
// fov=90, Godot render-target origin = top-left, camera-up rendered at top):
//   u = 0.5 * (1 + dot(dir, right) / dot(dir, view))
//   v = 0.5 * (1 - dot(dir, up)   / dot(dir, view))
//
// Sampling strategy:
//   * radial_depth / is_sky come from the DOMINANT face only. The validity
//     test must be strict, so it never averages depth across faces.
//   * colour is blended across the three axis pairs (sample_cube_color) so the
//     seams where two faces meet do not show up as hard colour steps.
// =============================================================================

struct CubeSample {
	vec3 color;         // seam-blended linear colour
	float radial_depth; // distance from capture centre along the dominant ray
	bool is_sky;        // true when alpha < 0 (sky sentinel)
	int face;           // dominant face, 0..5, for debug visualization
};

// Per-face (view, up) basis. Mirrors CaptureBank.FACE_VIEW / FACE_UP.
void face_basis(int face, out vec3 view, out vec3 up) {
	if (face == 0)      { view = vec3( 1.0, 0.0, 0.0); up = vec3(0.0, -1.0, 0.0); }
	else if (face == 1) { view = vec3(-1.0, 0.0, 0.0); up = vec3(0.0, -1.0, 0.0); }
	else if (face == 2) { view = vec3( 0.0, 1.0, 0.0); up = vec3(0.0,  0.0, 1.0); }
	else if (face == 3) { view = vec3( 0.0,-1.0, 0.0); up = vec3(0.0,  0.0,-1.0); }
	else if (face == 4) { view = vec3( 0.0, 0.0, 1.0); up = vec3(0.0, -1.0, 0.0); }
	else                { view = vec3( 0.0, 0.0,-1.0); up = vec3(0.0, -1.0, 0.0); }
}

vec2 face_uv(vec3 d, int face) {
	vec3 view;
	vec3 up;
	face_basis(face, view, up);
	vec3 right = normalize(cross(view, up));
	float dv = dot(d, view);
	float u = 0.5 * (1.0 + dot(d, right) / dv);
	float v = 0.5 * (1.0 - dot(d, up) / dv);
	return clamp(vec2(u, v), 0.0, 1.0);
}

vec4 fetch_face(sampler2D atlas, vec3 d, int face) {
	vec2 uv = face_uv(d, face);
	int col = face % 3;
	int row = face / 3;
	return texture(atlas, (uv + vec2(float(col), float(row))) / vec2(3.0, 2.0));
}

int dominant_face(vec3 d) {
	vec3 ad = abs(d);
	if (ad.x >= ad.y && ad.x >= ad.z) {
		return (d.x >= 0.0) ? 0 : 1;
	}
	if (ad.y >= ad.z) {
		return (d.y >= 0.0) ? 2 : 3;
	}
	return (d.z >= 0.0) ? 4 : 5;
}

// Seam-free colour: blend the three axis pairs by how well the direction aligns
// with each axis. At a cube edge two faces both contribute, which removes the
// hard discontinuity a single-face lookup produces there.
vec3 sample_cube_color(sampler2D atlas, vec3 d, float sharpness) {
	vec3 ad = abs(d);
	float max_axis = max(max(ad.x, ad.y), ad.z);
	vec3 w = pow(ad / max_axis, vec3(max(sharpness, 1.0)));
	w /= (w.x + w.y + w.z);

	if (max(w.x, max(w.y, w.z)) > 0.9995) {
		return fetch_face(atlas, d, dominant_face(d)).rgb;
	}

	vec3 col_x = mix(fetch_face(atlas, d, 1).rgb, fetch_face(atlas, d, 0).rgb, step(0.0, d.x));
	vec3 col_y = mix(fetch_face(atlas, d, 3).rgb, fetch_face(atlas, d, 2).rgb, step(0.0, d.y));
	vec3 col_z = mix(fetch_face(atlas, d, 5).rgb, fetch_face(atlas, d, 4).rgb, step(0.0, d.z));

	return w.x * col_x + w.y * col_y + w.z * col_z;
}

CubeSample sample_cube_atlas(sampler2D atlas, vec3 direction, float res) {
	vec3 d = normalize(direction);
	int face = dominant_face(d);
	vec4 tex = fetch_face(atlas, d, face);

	CubeSample s;
	s.color = sample_cube_color(atlas, d, params.extra.x);
	s.radial_depth = tex.a;
	s.is_sky = tex.a < 0.0;
	s.face = face;
	return s;
}
